# --- Core ---
ENV=development
SECRET_KEY=change-me-in-production
APP_BASE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# --- Database ---
# Used by docker-compose to set the Postgres credentials. The API/worker
# derive DATABASE_URL from this in compose; for local (non-Docker) runs set
# DATABASE_URL directly below.
POSTGRES_PASSWORD=projectdna
DATABASE_URL=postgresql+psycopg://projectdna:projectdna@localhost:5434/projectdna

# --- GitHub OAuth ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback
# Optional server-to-server token for public repo reads without user OAuth
GITHUB_TOKEN=

# --- Analysis limits ---
ANALYSIS_MAX_FILES=10000
ANALYSIS_MAX_COMMITS=2000
ANALYSIS_MAX_BYTES=209715200
ANALYSIS_MAX_FILE_BYTES=524288
ANALYSIS_TIMEOUT_SECONDS=3600
ANALYSIS_TMP_ROOT=./tmp

# --- Fixtures ---
FIXTURE_ROOT=./fixtures

# --- LLM (optional). Providers tried in order with automatic failover. ---
# llm_provider_order: comma list, e.g. "openrouter,groq,gemini,nvidia,ollama" or "auto" (all).
# Each provider is skipped when its key is empty. Ollama needs no key.
LLM_PROVIDER_ORDER=auto
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=700
LLM_TIMEOUT_SECONDS=60

# Ollama (local, no key required)
LLM_OLLAMA_BASE_URL=http://localhost:11434
LLM_OLLAMA_MODEL=
LLM_OLLAMA_TOKEN=

# OpenRouter (one key, many models)
LLM_OPENROUTER_API_KEY=
LLM_OPENROUTER_MODEL=openai/gpt-4o-mini

# Groq (fast)
LLM_GROQ_API_KEY=
LLM_GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini
LLM_GEMINI_API_KEY=
LLM_GEMINI_MODEL=gemini-2.0-flash

# NVIDIA NIM
LLM_NVIDIA_API_KEY=
LLM_NVIDIA_MODEL=meta/llama-3.3-70b-instruct